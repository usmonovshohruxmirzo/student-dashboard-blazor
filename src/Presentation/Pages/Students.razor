@page "/students"
@using StudentManagement.Domain.Enums
@inject HttpClient Http

<PageTitle>Students</PageTitle>

<h1 class="page-title">Students</h1>

<div class="search-bar">
    <input type="text" placeholder="Search students..." @bind="searchTerm" />
    <button>Search</button>
</div>

<table class="students-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Gender</th>
            <th>GPA</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in students)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Gender</td>
                <td>@student.Gpa</td>
                <td><span class="badge badge-success">@student.Status</span></td>
                <td>
                    <button class="delete-btn" @onclick="() => DeleteStudent(student.Id)">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<StudentDto> students = new();
    private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        students = await Http.GetFromJsonAsync<List<StudentDto>>("api/v1/students")
                    ?? new List<StudentDto>();
    }

    private async Task DeleteStudent(int id)
    {
        await Http.DeleteAsync($"api/v1/students/{id}");
        students = students.Where(x => x.Id != id).ToList();
    }

    public class StudentDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public Gender Gender { get; set; }
        public float Gpa { get; set; }
        public StudentStatus Status { get; set; }
    }
}
